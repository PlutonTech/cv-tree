{
  "manifest_version": 3,
  "name": "CV Tree",
  "version": "1.0.0",
  "description": "Spots job postings, picks your best-matching CV, and writes tailored CVs and cover letters with AI. Your CVs stay in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CV Tree",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "app.html#settings",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.anthropic.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdfgen.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "120"
}